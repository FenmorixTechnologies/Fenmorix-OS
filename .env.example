# Copy this file to .env and fill in the password.

# --- Database ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=sgfd
PGUSER=sgfd_app
PGPASSWORD=put-the-sgfd_app-password-here

# --- License ---
# Where the license file lives (default <SYSTEM_DIR>/license/nexus.lic). Install a new one from User Management > System > License.
# LICENSE_FILE=

# --- Department name and sandbox ---
# Leave these blank on St. George's server. Another department, or a sandbox, sets its own names here.
# ORG_NAME="St. George Fire Protection District"
# ORG_SHORT=SGFD
# Place name used in a few labels ("St. George's graded area")
# ORG_PLACE="St. George"
# App name in the tab title, side bar and emails (default "<ORG_SHORT> Nexus")
# APP_NAME="SGFD Nexus"
# Folder with replacement logo files (logo-large.png, nexus-emblem.png, favicon.ico, icon-192.png ...); a sandbox uses a generic set
# BRAND_ASSETS_DIR=
# on = sandbox: banner on every page, sign-up asks for their department, Investigations off, made-up active calls
# SANDBOX=off
# The banner text on a sandbox
# SANDBOX_NOTE=
# on = seed this department's own forms and evaluation programs (St. George's). Default: on, except on a sandbox
# DEPARTMENT_CONTENT=
# on = made-up active calls even without SANDBOX (off = none on a sandbox)
# CAD_DEMO=

# --- Server ---
PORT=3000
# 127.0.0.1 = only this computer can open the app
# 0.0.0.0   = other computers on the network can open it (see README: "Letting others use it")
HOST=127.0.0.1
# How long a sign-in lasts before people have to sign in again
SESSION_HOURS=12
# HTTPS: a certificate from IT so passwords travel encrypted. On the server,
# scripts\install-prereqs.ps1 fills these in (PORT=443, HOST=0.0.0.0).
# Either a .pfx file and its password:
# HTTPS_PFX_FILE=D:\sgfd-nexus\certs\sgfd.pfx
# HTTPS_PFX_PASSPHRASE=
# ...or a certificate + key pair (PEM):
# HTTPS_CERT_FILE=D:\sgfd-nexus\certs\sgfd.crt
# HTTPS_KEY_FILE=D:\sgfd-nexus\certs\sgfd.key
# With HTTPS on, also answer plain http on this port with a redirect to https:
# HTTP_REDIRECT_PORT=80
# Where uploaded invoices, receipts, contracts and certificates are stored
UPLOAD_DIR=./uploads
# Time zone used for meeting times
APP_TIMEZONE=America/Chicago

# --- Sign-in rules ---
# Passwords: 10+ characters with a capital letter, a lowercase letter and a symbol; changed every PASSWORD_MAX_DAYS days (0 = never).
# PASSWORD_MAX_DAYS=90
# Master admins and accounts admins sign in with an authenticator app code too. Leave on; "off" is for test machines only.
# MFA_ADMINS=on
# The address people use, for links in emails (password reset). No trailing slash.
PUBLIC_URL=https://nexus.stgeorgefire.com
# If Nexus is ever put behind a reverse proxy on this same computer, turn this on so rate limits still apply per visitor.
# RATE_LIMIT_LOOPBACK=on
# Behind Cloudflare (a Cloudflare Tunnel on this computer, or Cloudflare's proxy in front of it): "cloudflare" takes each visitor's real
# address from Cloudflare (sign-in limits, signed-in devices, audit log). Only trusted on requests that really came through Cloudflare.
# TRUST_PROXY=cloudflare

# --- Email for "Forgot your password?" (optional) ---
# The district's mail server. Without these, the sign-in page tells people to ask an accounts admin instead.
# Microsoft 365: smtp.office365.com, port 587, a mailbox allowed to use SMTP AUTH. Google Workspace: smtp.gmail.com with an app password.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=nexus@stgeorgefire.com
# SMTP_PASS=
# SMTP_FROM=SGFD Nexus <nexus@stgeorgefire.com>
# SMTP_TLS_CHECK=true

# --- Document autofill (optional) ---
# Reads PDFs, pictures, Excel, CSV and Word files on New requisition. Without a key, the screen says
# autofill isn't turned on and everything else works. The key stays on the server.
ANTHROPIC_API_KEY=
# Only if the assistant says the key "is not scoped to a workspace": the workspace ID from the Claude Console
# (Settings > Workspaces, starts with wrkspc_). Or make the key inside a workspace and leave this blank.
# ANTHROPIC_WORKSPACE_ID=
# AI_MODEL=claude-sonnet-4-6

# Largest Working Fire Recording upload, in MB
# RECORDINGS_MAX_MB=300

# Encryption key for sensitive form answers (SSN, date of birth).
# By default a key file is created at secrets/forms.key; back it up with the database.
# FORMS_KEY_FILE=D:\sgfd-nexus\secrets\forms.key

# Aladtec (who's on duty on Directory station cards). Ask Aladtec Support
# (888-749-5550, support@aladtec.com) for an API profile with access to schedules,
# scheduled time and members. Leave blank to turn it off.
ALADTEC_BASE_URL=
ALADTEC_CLIENT_ID=
ALADTEC_CLIENT_SECRET=
# When to check: one minute after shift change and every 3 hours from there
# (07:01, 10:01, 13:01, 16:01, 19:01, 22:01, 01:01, 04:01). Shifts start at ALADTEC_SHIFT_START.
# About 45 requests a day; Aladtec allows 2,500. The app stops itself at ALADTEC_DAILY_CAP (500).
# ALADTEC_REFRESH_TIMES=07:00,19:00
# ALADTEC_REFRESH_HOURS=3
# ALADTEC_DAILY_CAP=500
# ALADTEC_SHIFT_START=07:00

# Active calls on Your Day, from CentralSquare Enterprise CAD (SQL Server).
# The CAD admin sets up a read-only login and one view: scripts/cad-view-template.sql.
# Leave CAD_SQL_SERVER blank to turn it off.
CAD_SQL_SERVER=
CAD_SQL_PORT=1433
CAD_SQL_DATABASE=
CAD_SQL_USER=nexus_reader
CAD_SQL_PASSWORD=
CAD_SQL_VIEW=dbo.vw_nexus_active_calls
# CAD_SQL_ENCRYPT=true
# CAD_SQL_TRUST_CERT=false   (true only if SQL Server has a self-signed certificate)
# CAD_REFRESH_SECONDS=15

# Communications Statistics: closed incidents from a second read-only view
# (scripts/cad-stats-view-template.sql), same CAD_SQL_* login as above. Synced nightly.
# Leave CAD_STATS_VIEW blank (and CAD_SQL_SERVER blank) to keep it off.
CAD_STATS_VIEW=
# CAD_STATS_START=2025-01-01       first day to load on the first run (default: Jan 1 of last year)
# CAD_STATS_SYNC_TIME=02:15        nightly sync, server local time
# CAD_STATS_LOOKBACK_DAYS=7        days re-read each night (late dispositions)
# CAD_STATS_DISABLED=true

# Sign people out after this many minutes without using the app (background
# refreshes don't count), and after SESSION_HOURS no matter what.
# SESSION_IDLE_MINUTES=60

# Messages arrive instantly through a live connection from each open page. If something between
# the browser and the server breaks it (rare on the district network), turn it off and pages
# check every 30 seconds instead.
# LIVE_EVENTS=off

# Push notifications to phones/tablets need no keys (Nexus makes its own). Push services are told
# who to contact about this site; defaults to the site address.
# PUSH_CONTACT=mailto:it@stgeorgefire.com

# Working Fire transcripts (speech-to-text on this server). scripts\install-whisper.ps1 puts the
# program and model in ..\tools\whisper, where Nexus finds them; set these only to use other paths.
# WHISPER_BIN=D:\sgfd-nexus\tools\whisper\whisper-cli.exe
# WHISPER_MODEL=D:\sgfd-nexus\tools\whisper\ggml-small.en.bin
# WHISPER_THREADS=6
# SESSION_HOURS=12

# Weather on Your Day (National Weather Service; no key needed). Defaults to Headquarters.
# WEATHER_LAT=30.37
# WEATHER_LON=-91.01
# WEATHER_LABEL=St. George
# WEATHER_DISABLED=true

# IMT: "Find on map" uses the free US Census geocoder (no key). Tests point it at a stand-in.
# GEOCODER_BASE=https://geocoding.geo.census.gov

# ---- Active calls: waiting calls -------------------------------------------------------------------
# A call with no unit assigned drops off Active calls after this many minutes (units are normally assigned in 2-3 minutes)
# CAD_PENDING_MAX_MINUTES=10

# ---- System page (User Management > System) --------------------------------------------------------
# Needs scripts\install-updater.ps1 run once as administrator. Only change these if told to.
# UPDATER_TASK=SGFD Nexus Update

# --- Spot prices (Live Spot Prices module) ---
# Where prices come from: nfusion, metalpriceapi or demo (made-up prices, clearly labeled). Blank = off (demo on a sandbox).
SPOT_PROVIDER=
# The price source's key or token (a secret: never shown here once saved)
SPOT_API_KEY=
# Only if the provider gives a different address for spot prices
SPOT_API_URL=
# How often the server checks prices, in seconds (one check for everyone; every 30 minutes while markets are closed)
SPOT_REFRESH_SECONDS=60
