# Nexus web app (installed by install-ubuntu.sh). Logs: /opt/nexus/logs/sgfd-app.log
[Unit]
Description=Nexus Management System
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=nexus
Group=nexus
WorkingDirectory=/opt/nexus/app
ExecStart=/usr/bin/node server/index.js --production
Restart=always
RestartSec=5
# Ports 80 and 443 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
StandardOutput=append:/opt/nexus/logs/sgfd-app.log
StandardError=append:/opt/nexus/logs/sgfd-app.log

[Install]
WantedBy=multi-user.target
